<?php
/**
 * @file
 * To implement the hooks.
 */

/**
 * Implements hook_views_query_alter().
 */
function custom_view_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query) {
  if ($view->id() === 'players' && $view->current_display === 'page_1') {

    // Remove all default sorts.
    $query->orderby = [];

    // Add a new sort by title.
    $query->addOrderBy('node_field_data', 'title', 'DESC');
  }
}

/**
 * Implements hook_views_data_alter().
 */
function custom_view_views_data_alter(array &$data) {
  // Relate Players (content type) to their Team nodes.
  $data['node__field_team']['field_team_target_id']['relationship'] = [
    'title' => t('Team from Player'),
    'help' => t('Relates a Player node to its Team node.'),
    'id' => 'standard',
    'base' => 'node_field_data',
    'base field' => 'nid',
    'relationship field' => 'field_team_target_id',
    'label' => t('Team'),
  ];

}

/**
 * Implements hook_node_view().
 */
function custom_view_node_view(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display) {

  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'teams' && $entity instanceof \Drupal\node\NodeInterface) {

    if (!$entity->get('field_league')->isEmpty()) {
      $term_id = $entity->get('field_league')->target_id;

      $query = \Drupal::entityQuery('node')
        ->condition('type', 'teams')
        ->condition('status', 1)
        ->condition('field_league', $term_id)
        ->condition('nid', $entity->id(), '!=')
        ->range(0, 5)
        ->sort('created', 'DESC')
        ->accessCheck(TRUE);

      $nids = $query->execute();

      if (!empty($nids)) {
        $nodes = \Drupal\node\Entity\Node::loadMultiple($nids);

        $items = [];
        foreach ($nodes as $node) {
          $items[] = [
            '#type' => 'link',
            '#title' => $node->label(),
            '#url' => $node->toUrl(),
          ];
        }

        $build['related_nodes'] = [
          '#theme' => 'item_list',
          '#title' => \Drupal::translation()->translate('Other Teams in this League'),
          '#items' => $items,
          '#weight' => 1000,
        ];
      }
    }
  }
}

function custom_view_views_plugins_join_alter(array &$plugins) {
  // Print out all join plugin names for debugging purposes.
  dump($plugins);
}
