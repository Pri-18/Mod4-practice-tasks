<?php

/**
 * @file
 * Custom hook for the custom theme.
 */

use Drupal\node\NodeInterface;

/**
 * Implements hook_theme_suggestion_node_alter().
 */
function custom_theme_theme_suggestions_node_alter(array &$suggestions, array $variables) {
  $node = $variables['elements']['#node'];
  if ($node instanceof NodeInterface) {
    if ($node->getType() === 'article') {
      $suggestions[] = 'node__' . $node->id();
    }
  }
}

/**
 * Implements hook_theme_suggestions_block_alter().
 */
function custom_theme_theme_suggestions_block_alter(array &$suggestions, array $variables) {
  $curr_path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($curr_path);

  if ($alias === '/contact') {
    $suggestions[] = 'block__system';
  }
}

/**
 * Implements hook_custom_theme_suggestion_page_alter().
 */
function custom_theme_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  $curr_path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($curr_path);
  if ($alias === '/contact') {
    $suggestions[] = 'page__contact';
  }
}

/**
 * Implements hook_preprocess_node().
 */
function custom_theme_preprocess_node(array &$variables) {
  if ($variables['node']->getType() === 'article') {
    $variables['is_article'] = TRUE;
  }
}
